# Local dev only. In Lambda, these come from the function's env vars (set by Terraform).
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173
ITEMS_TABLE_NAME=portfolio-items
USERS_TABLE_NAME=portfolio-users
PLANNER_TABLE_NAME=portfolio-planner
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
AWS_REGION=eu-north-1

# Recent activity section. Uses the GitHub commit-search API. GITHUB_TOKEN is
# optional — without it the search API allows 10 requests/minute per IP (results
# are cached 10 min so this is plenty). A read-only classic/fine-grained token
# raises the limit to 30/minute.
GITHUB_USERNAME=OneTrickSupport
#GITHUB_TOKEN=

# Uncomment to use DynamoDB Local (docker compose up) instead of real AWS DynamoDB.
# Also set fake credentials so the SDK doesn't complain:
#AWS_ENDPOINT_URL=http://localhost:8000
#AWS_ACCESS_KEY_ID=local
#AWS_SECRET_ACCESS_KEY=local
